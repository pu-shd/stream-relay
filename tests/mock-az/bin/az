#!/usr/bin/env bash
# Mock `az`, placed first on PATH so the deployment scripts run entirely offline.
#
# Two jobs:
#   1. Return canned answers driven by $MOCK_AZ_SCENARIO.
#   2. Record every invocation to $MOCK_AZ_LOG so tests can assert on argv - which is how
#      idempotency ("a second run makes no mutating calls") is proven, and how we check the
#      passphrase never appears on a command line.
#
# Deliberately dumb: it pattern-matches argv rather than modelling Azure. A mock that tried
# to be a real resource graph would grow bugs of its own and stop being trustworthy.
set -uo pipefail

MOCK_AZ_LOG="${MOCK_AZ_LOG:-/tmp/mock-az.log}"
MOCK_AZ_SCENARIO="${MOCK_AZ_SCENARIO:-fresh}"

printf '%s\n' "$*" >> "$MOCK_AZ_LOG"

# Which resources "exist" in this scenario. `fresh` = nothing; `existing` = everything;
# `partial` = up to the infra step; `provider-unregistered` mirrors a subscription where a
# needed provider is NotRegistered.
resource_exists() {
  # The resource group ALWAYS exists. This deployment adopts a shared group it did not
  # create and refuses to invent one, so "absent" is a fatal misconfiguration rather than a
  # state any scenario should model.
  # The resource group, the VM and its Key Vault ALWAYS exist. This deployment adopts a host
  # it did not create and refuses to invent one, so "absent" is a fatal misconfiguration
  # rather than a state any scenario should model.
  case "$1" in group|vm|keyvault) return 0 ;; esac
  case "$MOCK_AZ_SCENARIO" in
    # orphaned-disk models "everything existed, teardown ran, but a disk survived", so the
    # resources must exist or teardown exits early and never reaches the orphan check.
    # missing-rbac models a real RG whose identities exist but were never granted
    # roles, so the group and identity must exist for the guard to reach the check.
    existing|orphaned-disk|missing-rbac) return 0 ;;
    partial)
      case "$1" in
        group|identity|keyvault|acr|network) return 0 ;;
        *) return 1 ;;
      esac ;;
    *) return 1 ;;
  esac
}

emit() { printf '%s' "$1"; }

# Key on the first FOUR words. Three was not enough: commands like
#   az storage blob service-properties show
#   az network front-door waf-policy show
# have their verb in position 4, so every such pattern silently fell through to the
# unhandled-command branch and the caller took its error path instead. That made some
# assertions pass for the wrong reason.
case "$1 ${2:-} ${3:-} ${4:-}" in
  "account show "*)
    emit '{"id":"00000000-0000-0000-0000-000000000000","name":"MOCK-sub","user":{"name":"mock@princeton.edu"},"tenantId":"11111111-1111-1111-1111-111111111111"}'
    ;;

  "account list "*|"account list")
    emit $'MOCK-sub\t00000000-0000-0000-0000-000000000000'
    ;;

  "account set "*) ;;

  "bicep version"*) emit 'Bicep CLI version 0.43.8' ;;

  "ad signed-in-user show"*) emit '22222222-2222-2222-2222-222222222222' ;;

  "role assignment list"*)
    # Two different questions come through here: the operator's own roles, and the VM
    # identity's roles (queried by principal id to prove RBAC was established).
    if printf '%s' "$*" | grep -q '44444444-4444-4444-4444-444444444444'; then
      case "$MOCK_AZ_SCENARIO" in
        # missing-rbac: the identity exists but was never granted anything, which is what
        # a first-ever CI deploy against a never-bootstrapped RG looks like.
        missing-rbac) emit '' ;;
        *) emit $'Key Vault Secrets User\nAcrPull' ;;
      esac
    elif [ "$MOCK_AZ_SCENARIO" = "contributor-only" ]; then
      emit $'Contributor'
    elif [ "$MOCK_AZ_SCENARIO" = "reader-only" ]; then
      emit $'Reader'
    else
      emit $'Owner'
    fi
    ;;

  "identity show"*)
    case "$MOCK_AZ_SCENARIO" in
      existing|orphaned-disk|missing-rbac|contributor-only)
        emit '44444444-4444-4444-4444-444444444444' ;;
      *) exit 1 ;;
    esac
    ;;

  "provider show "*)
    ns=""
    for ((i = 1; i <= $#; i++)); do
      [ "${!i}" = "-n" ] && { j=$((i + 1)); ns="${!j}"; }
    done
    # Microsoft.Consumption stands in for any NotRegistered provider, so the test can
    # assert step 2 actually registers it rather than failing later at Front Door.
    if [ "$MOCK_AZ_SCENARIO" = "provider-unregistered" ] && [ "$ns" = "Microsoft.Consumption" ]; then
      if [ -f "${MOCK_AZ_STATE_DIR:-/tmp}/cdn-registered" ]; then
        emit 'Registered'
      else
        emit 'NotRegistered'
      fi
    else
      emit 'Registered'
    fi
    ;;

  "provider register"*)
    touch "${MOCK_AZ_STATE_DIR:-/tmp}/cdn-registered"
    ;;

  "vm list-usage"*)
    if [ "$MOCK_AZ_SCENARIO" = "no-quota" ]; then
      # Both families: the deployment may adopt a previous-generation host, so a fixture
      # naming only the current family makes the check inconclusive rather than failing.
      emit '[{"localName":"Standard Dsv6 Family vCPUs","currentValue":350,"limit":350},{"localName":"Standard Dsv5 Family vCPUs","currentValue":350,"limit":350}]'
    else
      emit '[{"localName":"Standard Dsv6 Family vCPUs","currentValue":0,"limit":350},{"localName":"Standard Dsv5 Family vCPUs","currentValue":0,"limit":350}]'
    fi
    ;;

  "vm list-skus"*)
    # The scripts ask two different questions of this command: "does the SKU exist"
    # (JSON) and "what are its restrictions" (-o tsv). Answering both with JSON made an
    # unrestricted SKU look restricted, so the mock distinguishes them.
    if printf '%s' "$*" | grep -q 'reasonCode'; then
      [ "$MOCK_AZ_SCENARIO" = "sku-restricted" ] && emit 'NotAvailableForSubscription' || emit ''
    else
      emit '[{"name":"Standard_D4s_v6","restrictions":[]}]'
    fi
    ;;

  "group exists"*)
    resource_exists group && emit 'true' || emit 'false'
    ;;

  "group create"*|"group delete"*) ;;

  "deployment group what-if"*) emit '{"changes":[]}' ;;

  "deployment group create"*)
    emit '{"properties":{"outputs":{
      "frontDoorHostName":{"value":"orfe-relay-mockhash1234.z01.azurefd.net"},
      "ingestIpAddress":{"value":"203.0.113.42"},
      "acrLoginServer":{"value":"acrorfestreamrelay.azurecr.io"},
      "keyVaultName":{"value":"kv-orfe-relay"},
      "identityClientId":{"value":"33333333-3333-3333-3333-333333333333"}}}}'
    ;;

  "keyvault secret show"*)
    resource_exists secret && emit '{"value":"MockPassphrase0123456789abcdefghij"}' || exit 1
    ;;

  "keyvault secret set"*) ;;

  "acr build"*) ;;
  "acr delete"*) ;;

  "storage blob service-properties show"*)
    # Static-website hosting is off on a fresh account and must be switched on explicitly;
    # there is no ARM equivalent.
    case "$MOCK_AZ_SCENARIO" in
      existing|orphaned-disk|missing-rbac) emit 'true' ;;
      *) emit 'false' ;;
    esac
    ;;
  "storage blob service-properties update"*) ;;
  "storage account show"*) emit 'https://storfeorferelayhls.z13.web.core.windows.net/' ;;
  "storage account delete"*) ;;

  "keyvault list-deleted"*) emit '' ;;
  "keyvault purge"*) ;;
  "keyvault delete"*) ;;
  "identity delete"*) ;;

  "afd endpoint show"*) emit 'orfe-relay-mockhash1234.z01.azurefd.net' ;;

  "afd custom-domain show"*)
    emit 'Pending'
    ;;

  "afd profile show"*) resource_exists frontdoor || exit 1 ;;
  "afd profile delete"*)
    # The real CLI has no --yes for this command and errors with "unrecognized arguments".
    # The mock previously accepted anything, which let that bug reach a live teardown.
    if printf '%s' "$*" | grep -q -- '--yes'; then
      printf "MOCK-AZ: 'az afd profile delete' does not accept --yes\n" >&2
      exit 2
    fi
    ;;

  "vm show"*) resource_exists vm || exit 1 ;;
  "keyvault show"*) resource_exists keyvault || exit 1 ;;
  "vm delete"*) ;;
  "vm run-command invoke"*)
    # configure-vm asks two different things through Run Command: whether cloud-init has
    # finished, and whether the relay container became healthy. Returning a generic string
    # for both made the cloud-init wait loop spin for its full 600s timeout, which hung the
    # offline suite - a mock that is too vague costs real test time.
    if printf '%s' "$*" | grep -q 'cloud-init status'; then
      emit 'status: done'
    elif [ "$MOCK_AZ_SCENARIO" = "relay-unhealthy" ]; then
      emit 'service=failed mirror=failed'
    elif [ "$MOCK_AZ_SCENARIO" = "mirror-down" ]; then
      # MediaMTX healthy but the mirror dead: segments pile up on the VM and the CDN
      # serves 404s. Looks fine from the container's point of view, delivers nothing.
      emit 'RELAY_HEALTHY
service=active mirror=failed
Up 10 seconds (healthy)'
    else
      emit 'RELAY_HEALTHY
MIRROR_ACTIVE
service=active mirror=active
Up 10 seconds (healthy)'
    fi
    ;;

  "network nsg show"*|"network vnet show"*|"network nic show"*)
    resource_exists network || exit 1 ;;
  "network public-ip show"*) resource_exists network || exit 1 ;;
  "network nsg rule update"*) ;;
  # The relay's own rule. Present whenever the deployment is, so teardown has something to
  # remove; the HTTPS and ACME rules are deliberately NOT modelled as removable, because
  # teardown must never touch them.
  "network nsg rule show"*)
    case "$*" in
      *AllowSrtIngest*) resource_exists nsg-rule && emit '{"name":"AllowSrtIngest"}' || exit 1 ;;
      *) exit 1 ;;
    esac ;;
  "network nsg rule delete"*) ;;
  "network nsg rule list"*) emit '[]' ;;
  "network nsg delete"*|"network vnet delete"*|"network nic delete"*|"network public-ip delete"*) ;;
  "network front-door waf-policy show"*) resource_exists frontdoor || exit 1 ;;
  "network front-door waf-policy delete"*) ;;

  "resource list"*)
    # teardown.sh asks twice: once for a table of everything, and once with a type filter
    # (-o tsv) to detect leftover BILLABLE resources. Ignoring the filter made the orphan
    # check fire always, so the mock distinguishes them.
    if printf '%s' "$*" | grep -q 'Microsoft.Compute/disks'; then
      case "$MOCK_AZ_SCENARIO" in
        orphaned-disk) emit 'leftover-disk' ;;
        *) emit '' ;;
      esac
      exit 0
    fi
    case "$MOCK_AZ_SCENARIO" in
      after-soft-teardown)
        # ACR, Key Vault and the identity survive --soft on purpose; nothing billable
        # by the hour remains.
        emit '[{"name":"acrorfestreamrelay","type":"Microsoft.ContainerRegistry/registries"},{"name":"kv-orfe-relay","type":"Microsoft.KeyVault/vaults"},{"name":"id-orfe-relay","type":"Microsoft.ManagedIdentity/userAssignedIdentities"}]'
        ;;
      orphaned-disk)
        emit '[{"name":"leftover-disk","type":"Microsoft.Compute/disks"}]'
        ;;
      *)
        emit '[{"name":"vm-orfe-relay","type":"Microsoft.Compute/virtualMachines"},{"name":"relay-pip","type":"Microsoft.Network/publicIPAddresses"}]'
        ;;
    esac
    ;;

  "consumption budget"*) resource_exists budget || exit 1 ;;

  *)
    # Unknown command: fail loudly rather than silently returning success, which would let
    # a test pass while the real az call was wrong.
    printf 'MOCK-AZ: unhandled command: %s\n' "$*" >&2
    exit 64
    ;;
esac
exit 0
